//- Блок 2 (Галерея ліворуч - якщо потрібен реверс, додай клас .simulator--reverse до секції)
section.simulator.section#simulator-2
    .container
        .pre-title Безпека та усвідомленість за кермом
        h2.title Окуляри-симулятори Drunk Busters у Кропивницькому

        //- Виправлено h3 на p для збереження правильної ієрархії
        p.subtitle.h5.text-light Єдина автошкола в місті, де ви можете безпечно відчути, як алкоголь впливає на реакцію та координацію водія.

        //- Додано ключі: "ДТП", "швидкість реакції", "координація рухів"
        p Ці спеціальні окуляри — не просто тренажер, а потужний інструмент профілактики ДТП. Зовні вони нагадують гірськолижну маску, але після надягання повністю імітують стан сп'яніння (0,2–0,4 проміле): зір затуманюється, швидкість реакції сповільнюється, а координація рухів суттєво порушується.

        .simulator__grid
            .simulator__gallery.gallery-swiper-wrapper
                .swiper.gallery-swiper-main
                    .swiper-wrapper
                        .swiper-slide
                            picture
                                source(srcset="img/glass-1.webp" type="image/webp")
                                //- Оптимізовані alt-тексти
                                img(src="img/glass-1.jpg", alt="Окуляри-симулятори сп'яніння Drunk Busters в автошколі Центр", loading="lazy", width="450", height="532")
                        .swiper-slide
                            picture
                                source(srcset="img/glass-2.webp" type="image/webp")
                                img(src="img/glass-2.jpg", alt="Практичне заняття з окулярами імітації сп'яніння у Кропивницькому", loading="lazy", width="500", height="459")
                        .swiper-slide
                            .video-local#video-container
                                video.video-local__player(preload="none" poster="img/glass-3.webp" playsinline muted)
                                    source(src="img/glass-3.mp4", type="video/mp4")
                                button.video-local__play(aria-label="Запустити відео")
                                    svg(viewBox="0 0 64 64" width="64" height="64")
                                        circle(cx="32" cy="32" r="32" fill="#007bff" opacity="0.9")
                                        path(d="M26 20l18 12-18 12V20z" fill="#ffffff")
                .swiper.gallery-swiper-thumbs
                    .swiper-wrapper
                        .swiper-slide
                            picture
                                source(srcset="img/glass-1.webp" type="image/webp")
                                img(src="img/glass-1.jpg", alt="Мініатюра - окуляри Drunk Busters", loading="lazy", width="450", height="532")
                        .swiper-slide
                            picture
                                source(srcset="img/glass-2.webp" type="image/webp")
                                img(src="img/glass-2.jpg", alt="Мініатюра - тренінг з безпеки водіння", loading="lazy", width="500", height="459")
                        .swiper-slide
                            picture
                                source(srcset="img/glass-3.webp" type="image/webp")
                                img(src="img/glass-3.jpg", alt="Мініатюра відео - вплив алкоголю на водія", loading="lazy", width="560", height="1013")

            .simulator__content.content
                //- Використано p.h5 замість заголовка, щоб не ламати структуру
                p.text-bold.h5 Чому цей досвід рятує життя:
                ul.list.list-check
                    li
                        span
                            <b>Наочна демонстрація:</b> реалістичне відчуття втрати контролю над автомобілем
                    li
                        span
                            <b>Абсолютна безпека:</b> тренінг з безпеки дорожнього руху проходить у класі без ризику
                    li
                        span
                            <b>Формування звички:</b> стійке психологічне табу на керування авто напідпитку

                //- Додано фінальний заклик бути відповідальним водієм (LSI)
                p Ми в автошколі «Центр» віримо в «ефект метелика». Цей практичний досвід закарбується в пам'яті назавжди. Якщо в майбутньому виникне спокуса сісти за кермо після келиха, ви згадаєте це відчуття безпорадності — і просто викличете таксі. Наша мета — випускати на дороги відповідальних водіїв!
                p
                    +btn( "primary", "normal", true)
                        span Записатись на курс
