//- Блок 1 (Галерея праворуч)
section.simulator.section#simulator
    .container
        .simulator__header
            .pre-title Боїтеся одразу сідати за кермо?
            h2.title Автотренажер-симулятор водіння у Кропивницькому
            h3.subtitle.h5.text-light Почніть навчання без страху та стресу. Автошкола «Центр» — єдина в місті, де ви можете відпрацювати перші навички керування на сучасному автотренажері на базі DAEWOO.

        .simulator__grid
            .simulator__gallery.gallery-swiper-wrapper
                //- Головний слайдер
                .swiper.gallery-swiper-main
                    .swiper-wrapper
                        .swiper-slide
                            picture
                                source(srcset="img/simulator-1.webp" type="image/webp")
                                img(src="img/simulator-1.jpg", alt="Фото автотренажера", loading="lazy", width="480", height="640")
                        .swiper-slide
                            picture
                                source(srcset="img/simulator-2.webp" type="image/webp")
                                img(src="img/simulator-2.jpg", alt="Фото працюючого автотренажера", loading="lazy", width="480", height="640")
                        .swiper-slide
                            .video-local#video-container
                                video.video-local__player(
                                    preload="none"
                                    poster="img/simulator-3.webp"
                                    playsinline
                                    muted
                                )
                                    source(src="img/simulator-3.mp4", type="video/mp4")
                                    | Ваш браузер не підтримує відтворення відео.

                                button.video-local__play(aria-label="Запустити відео")
                                    svg(viewBox="0 0 64 64" width="64" height="64")
                                        circle(cx="32" cy="32" r="32" fill="#007bff" opacity="0.9")
                                        path(d="M26 20l18 12-18 12V20z" fill="#ffffff")

                //- Мініатюри (Thumbs)
                .swiper.gallery-swiper-thumbs
                    .swiper-wrapper
                        .swiper-slide
                            picture
                                source(srcset="img/simulator-1.webp" type="image/webp")
                                img(src="img/simulator-1.jpg", alt="Мініатюра фотографії автотренажера", loading="lazy", width="480", height="640")
                        .swiper-slide
                            picture
                                source(srcset="img/simulator-2.webp" type="image/webp")
                                img(src="img/simulator-2.jpg", alt="Мініатюра фотографії автотренажера", loading="lazy", width="480", height="640")
                        .swiper-slide
                            picture
                                source(srcset="img/simulator-3.webp" type="image/webp")
                                img(src="img/simulator-3.jpg", alt="Мініатюра до відео автотренажера", loading="lazy", width="480", height="640")

            .simulator__content.content
                p Головна перевага тренажера — повна безпека та швидка адаптація. Ви навчитеся відчувати габарити автомобіля, працювати з педалями та перемикати передачі ще до першого виїзду у реальний міський трафік.

                .simulator__pricing.p-3.mb-3.bg-light.border.rounded-3
                    p.mb-1 💡 <strong>Умови використання:</strong>
                    p.mb-0 Для учнів нашої автошколи заняття на тренажері — #[strong абсолютно безкоштовно]. Для всіх інших: #[strong перше пробне заняття — безкоштовно], наступні — 300 грн/год.

                p.text-bold.h5 Перші навички — ще до виїзду на дорогу:
                ul.list.list-check
                    li Безпечно освоїте базове керування
                    li Звикнете до габаритів та органів управління
                    li Відпрацюєте аварійні та складні дорожні ситуації
                    li Подолаєте страх перед першим виїздом у місто
                p
                    +btn( "primary", "normal", true)
                        span Спробувати автотренажер
