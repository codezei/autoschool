//- Блок 1 (Галерея праворуч)
section.simulator.section#simulator
    .container
        .simulator__header
            .pre-title Боїтеся одразу сідати за кермо?
            //- H2 містить точне входження ключа та гео-маркер
            h2.title Автотренажер-симулятор для навчання водінню у Кропивницькому

            //- Змінено h3 на p, щоб не порушувати семантику заголовків
            p.subtitle.h5.text-light Почніть навчання без страху та стресу. Автошкола «Центр» — єдина в місті, де ви можете відпрацювати перші навички керування на сучасному автосимуляторі на базі автомобіля DAEWOO.

            //- Додано LSI-ключі: "зчеплення", "міський трафік"
            p Головна перевага тренажера — повна безпека та швидка адаптація. Ви навчитеся відчувати габарити автомобіля, плавно відпускати зчеплення, працювати з педалями та перемикати передачі ще до першого виїзду в реальний міський трафік.

        .simulator__grid
            .simulator__gallery.gallery-swiper-wrapper
                //- Головний слайдер
                .swiper.gallery-swiper-main
                    .swiper-wrapper
                        .swiper-slide
                            picture
                                source(srcset="img/simulator-1.webp" type="image/webp")
                                //- Розширено alt для SEO по картинках
                                img(src="img/simulator-1.jpg", alt="Автотренажер DAEWOO для навчання водінню в автошколі Центр", loading="lazy", width="480", height="640")
                        .swiper-slide
                            picture
                                source(srcset="img/simulator-2.webp" type="image/webp")
                                img(src="img/simulator-2.jpg", alt="Практичне заняття на симуляторі водіння Кропивницький", loading="lazy", width="480", height="640")
                        .swiper-slide
                            .video-local#video-container
                                video.video-local__player(
                                    preload="none"
                                    poster="img/simulator-3.webp"
                                    playsinline
                                    muted
                                )
                                    source(src="img/simulator-3.mp4", type="video/mp4")
                                    | Ваш браузер не підтримує відтворення відео.

                                button.video-local__play(aria-label="Запустити відео")
                                    svg(viewBox="0 0 64 64" width="64" height="64")
                                        circle(cx="32" cy="32" r="32" fill="#007bff" opacity="0.9")
                                        path(d="M26 20l18 12-18 12V20z" fill="#ffffff")

                //- Мініатюри (Thumbs)
                .swiper.gallery-swiper-thumbs
                    .swiper-wrapper
                        .swiper-slide
                            picture
                                source(srcset="img/simulator-1.webp" type="image/webp")
                                img(src="img/simulator-1.jpg", alt="Мініатюра - автосимулятор автошколи", loading="lazy", width="480", height="640")
                        .swiper-slide
                            picture
                                source(srcset="img/simulator-2.webp" type="image/webp")
                                img(src="img/simulator-2.jpg", alt="Мініатюра - навчання на автотренажері", loading="lazy", width="480", height="640")
                        .swiper-slide
                            picture
                                source(srcset="img/simulator-3.webp" type="image/webp")
                                img(src="img/simulator-3.jpg", alt="Мініатюра до відео уроку на автотренажері", loading="lazy", width="480", height="640")

            .simulator__content.content

                .simulator__pricing.p-3.mb-3.bg-light.border.rounded-3
                    p.mb-1 💡 <strong>Умови використання:</strong>
                    p.mb-0 Для учнів нашої автошколи заняття на тренажері — #[strong абсолютно безкоштовні]. Для всіх інших: #[strong перше пробне заняття — безкоштовно], наступні — 300 грн/год.

                p.text-bold.h5 Перші навички — ще до виїзду на дорогу:
                ul.list.list-check
                    //- Розширено буліти корисними ключовими словами
                    li Безпечно освоїте базове керування (кермо, педалі, КПП)
                    li Відпрацюєте рушання з місця без ризику заглухнути
                    li Навчитеся діяти в аварійних та складних дорожніх ситуаціях
                    li Подолаєте страх перед першим виїздом на вулиці міста
                p
                    +btn( "primary", "normal", true)
                        span Спробувати автотренажер
