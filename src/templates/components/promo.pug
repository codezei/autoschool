section.promo.section#promo
    .container
        .promo-grid
            .promo-grid__head.promo__head
                .pre-title Автошкола «Центр»
                //- H1 скорочено до 56 символів (Screaming Frog ліміт - 70). Концентрований SEO-ключ.
                h1.title.promo__title Автошкола у&nbsp;Кропивницькому: курси водіння категорії&nbsp;B

                //- Замінили h2 на p, щоб не порушувати ієрархію заголовків і прибрати помилку Screaming Frog
                p.subtitle.promo__subtitle.h5.text-light Отримати посвідчення водія простіше, ніж здається. <br>Практика на офіційних маршрутах ТСЦ, сучасні авто та повний супровід.

            .promo-grid__list.promo__list
                ul.list.list-chevron.list-row
                    li 15 років досвіду <br>навчання водіїв
                    li Практика на <br>маршрутах ТСЦ
                    li Сучасні авто <br>АКПП та МКПП

            .promo-grid__offer.promo__offer
                .card.card-primary
                    .card__body
                        .card__frame
                            //- Змінили h3 на p, оскільки це елемент UI, а не структурний розділ сторінки
                            p.card__title.h5.text-bold Повний курс (теорія + практика)
                            .row.row-cols-2
                                .col
                                    .price-old 14&nbsp;000&nbsp;грн
                                    .price-new 13&nbsp;000&nbsp;грн
                                    p До&nbsp;
                                        span= deadline
                                    include timer
                                .col
                                    picture
                                        source(srcset="img/helm.webp" type="image/webp")
                                        img.helm(src="img/helm.png", alt="Курси водіння категорії B у Кропивницькому - Автошкола Центр", width="200", height="174", loading="eager")
                    .card__footer
                        .card__footer-btn
                            +btn( "cta", "normal", true)
                                span Забронювати місце в групі
                        .card__footer-text.text-shadow-dark І вже через 9 тижнів ти будеш готовий до іспиту в ТСЦ

            .promo-grid__graduate.promo__graduate
                picture
                    source(srcset="img/student-mob.webp" type="image/webp" media="(max-width: 575px)")
                    source(srcset="img/student-mob.png" media="(max-width: 575px)")
                    source(srcset="img/student.webp" type="image/webp")
                    //- LCP Зображення: атрибути пріоритету залишені правильними
                    img.promo__graduate-img(src="img/student.png", alt="Учень автошколи Центр Кропивницький з посвідченням водія", width="974", height="987", loading="eager", fetchpriority="high")

            .promo-grid__proof.promo__proof
                .proof
                    img.proof__icon(src="img/google-icon.svg", alt="Відгуки про автошколу Центр у Google", width="30", height="30")
                    div
                        .proof__rating.rating(style="--star-rating: 5;")
                        b.text-bold 5.0
                        |&nbsp;
                        a.proof__reviews(href="https://google.com/maps?cid=9312322946195322361&g_mp=CiVnb29nbGUubWFwcy5wbGFjZXMudjEuUGxhY2VzLkdldFBsYWNlEAMYASAFKgSoqNcy", target="_blank", rel="noopener") 32 відгуки
