section.courses.section.section-road
    .container
        .pre-title Програми навчання
        h2.title Ціни на навчання в автошколі «Центр» у Кропивницькому
        h3.subtitle.text-light.h5 Від нуля до впевненого водіння в Кропивницькому — оберіть потрібну програму
        ul.row.row-cols-lg-3
            li.col
                .card.card-secondary
                    .card__body
                        h4.card__title.h5.w-100.text-center Практичний курс
                        table.card__table.table
                            tbody
                                tr
                                    td Ціна
                                    td 6 000 грн*
                                        span (без палива)
                                tr
                                    td Тривалість
                                    td 6 тижнів
                                tr
                                    td Старт
                                    td Набір триває до&nbsp;
                                        span= deadline
                                tr
                                    td Категорія
                                    td B
                        p.card__text.text-small *у ціну не входить паливо
                        .card__row.row.row-cols-2
                            .col
                                div МКПП
                                div 350 грн/заняття
                            .col
                                div АКПП
                                div 500 грн/заняття
                    .card__footer
                        +btn("#", "primary", "normal", true)
                            span Записатись
            li.col.courses-main-col
                .card.card-primary
                    .card__body
                        .card__frame
                            h4.card__title.h5.text-center Повний курс (Теорія + Практика)
                            table.card__table.table
                                tbody
                                    tr
                                        td Ціна
                                        td
                                            .price-old 14&nbsp;000&nbsp;грн
                                            .price-new 13&nbsp;000&nbsp;грн
                                    tr
                                        td Тривалість
                                        td 9 тижнів
                                    tr
                                        td Старт
                                        td Набір триває до&nbsp;
                                            span= deadline
                                    tr
                                        td Категорія
                                        td B
                            .card__row.row.row-cols-2
                                .col
                                    strong ONLINE
                                    div індивідуальний графік
                                .col
                                    strong OFFLINE
                                    div Пн-Пт 17:00-19:00
                    .card__footer
                        +btn("#", "cta", "normal", true)
                            span Записатись
            li.col
                .card.card-secondary
                    .card__body
                        h4.card__title.h5.w-100.text-center Теоретичний курс
                        table.card__table.table
                            tbody
                                tr
                                    td Ціна
                                    td 5 000 грн
                                tr
                                    td Тривалість
                                    td 3 тижні
                                tr
                                    td Старт
                                    td Набір триває до &nbsp;
                                        span= deadline
                                tr
                                    td Категорія
                                    td B
                        .card__row.row.row-cols-2
                            .col
                                strong ONLINE
                                div індивідуальний графік
                            .col
                                strong OFFLINE
                                div Пн-Пт 17:00-19:00
                    .card__footer
                        +btn("#", "primary", "normal", true)
                            span Записатись
