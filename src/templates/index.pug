extends settings/layout

prepend html
    - const lang = "pl";

prepend head
    - const pageTitle = "Автошкола Кропивницький «Центр» — Курси водіння та підготовка до іспитів"
    - const themeColor = "#ffffff"
    - const pageDescription = "Автошкола у Кропивницькому: навчання на категорію B. Практика на маршрутах ТСЦ, автотренажер, авто АКПП/МКПП. Доступні ціни! ☎ (050) 596-90-13"
    - const pageKeywords = ""
    - const pageUrl = "";
    - const pageImage = "img/preview.webp";
    - const twitterImage = "img/preview.webp";
    - const deadline = '04.09.2026'

append head
    include components/schema

append fonts
    style.
        @font-face {
            font-display: swap; /* Check https://developer.mozilla.org/en-US/docs/Web/CSS/@font-face/font-display for other options. */
            font-family: 'IBM Plex Sans';
            font-style: normal;
            font-weight: 300;
            src: url('./fonts/ibm-plex-sans-v23-cyrillic-ext-300.woff2') format('woff2'); /* Chrome 36+, Opera 23+, Firefox 39+, Safari 12+, iOS 10+ */
        }
        @font-face {
            font-display: swap; /* Check https://developer.mozilla.org/en-US/docs/Web/CSS/@font-face/font-display for other options. */
            font-family: 'IBM Plex Sans';
            font-style: normal;
            font-weight: 700;
            src: url('./fonts/ibm-plex-sans-v23-cyrillic-ext-700.woff2') format('woff2'); /* Chrome 36+, Opera 23+, Firefox 39+, Safari 12+, iOS 10+ */
        }

append content
    include mixins/date
    include mixins/messengers
    include mixins/btn
    include mixins/faq-item
    include components/header
    main
        include components/promo
        include components/courses
        include components/banner
        include components/about
        include components/why
        hr.hr
        include components/simulator
        hr.hr
        include components/simulator-2
        hr.hr
        include components/park
        include components/process
        include components/reviews
        include components/banner-2
        include components/faq
        include components/banner-3
        include components/contacts
        include components/icons
        +messengers()
    include components/footer
append scripts
