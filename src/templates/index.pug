extends settings/layout

prepend html
    - const lang = "uk";

prepend head
    - const pageTitle = "Автошкола «Центр» у Кропивницькому | Курси водіння"
    - const themeColor = "#ffffff"
    - const pageDescription = "Курси водіння у Кропивницькому (кат. B). Авто АКПП/МКПП, автотренажер, практика в ТСЦ. ☎ (050) 596-90-13"
    - const pageKeywords = ""
    - const pageUrl = "";
    - const pageImage = "img/og-image.webp";
    - const twitterImage = "img/og-image.webp";
    - const deadline = '04.09.2026'

append head
    meta(name="robots" content="index, follow")
    link(rel="preload" as="image" href="img/student-mob.webp" type="image/webp" media="(max-width: 575px)" fetchpriority="high")
    link(rel="preload" href="fonts/ibm-plex-sans-v23-cyrillic-ext-300.woff2" as="font" type="font/woff2" crossorigin fetchpriority="high")
    link(rel="preload" href="fonts/ibm-plex-sans-v23-cyrillic-ext-700.woff2" as="font" type="font/woff2" crossorigin fetchpriority="high")
    include components/schema

append fonts
    style.
        @font-face {
            font-display: swap; /* Check https://developer.mozilla.org/en-US/docs/Web/CSS/@font-face/font-display for other options. */
            font-family: 'IBM Plex Sans';
            font-style: normal;
            font-weight: 300;
            src: url('./fonts/ibm-plex-sans-v23-cyrillic-ext-300.woff2') format('woff2'); /* Chrome 36+, Opera 23+, Firefox 39+, Safari 12+, iOS 10+ */
        }
        @font-face {
            font-display: swap; /* Check https://developer.mozilla.org/en-US/docs/Web/CSS/@font-face/font-display for other options. */
            font-family: 'IBM Plex Sans';
            font-style: normal;
            font-weight: 700;
            src: url('./fonts/ibm-plex-sans-v23-cyrillic-ext-700.woff2') format('woff2'); /* Chrome 36+, Opera 23+, Firefox 39+, Safari 12+, iOS 10+ */
        }

append content
    include mixins/date
    include mixins/messengers
    include mixins/btn
    include mixins/faq-item
    include components/header
    main
        include components/promo
        include components/courses
        include components/banner
        include components/about
        include components/why
        hr.hr
        include components/simulator
        hr.hr
        include components/simulator-2
        hr.hr
        include components/park
        include components/process
        include components/reviews
        include components/banner-2
        include components/faq
        include components/banner-3
        include components/contacts
        include components/icons
        +messengers()
    include components/footer
append scripts
