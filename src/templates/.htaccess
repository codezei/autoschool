# ==========================================
# HTTPS + WWW -> NON-WWW
# ==========================================

<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Редирект з index.html на головну (зберігаючи слеш)
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.html\ HTTP/ [NC]
    RewriteRule ^index\.html$ https://autoschool-center.com.ua/ [R=301,L]

    # 2. Універсальний редирект з www та http на https:// non-www
    RewriteCond %{HTTPS} !=on [OR]
    RewriteCond %{HTTP_HOST} ^www\.(.+) [NC]
    RewriteRule ^ https://autoschool-center.com.ua%{REQUEST_URI} [R=301,L]
</IfModule>


# ==========================================
# CHARSET
# ==========================================

AddDefaultCharset UTF-8


# ==========================================
# CUSTOM 404
# ==========================================

ErrorDocument 404 /404.html


# ==========================================
# SECURITY HEADERS (Вимоги безпеки Google)
# ==========================================

<IfModule mod_headers.c>
    # HSTS (Захищене зєднання)
    Header always set Strict-Transport-Security "max-age=31536000"

    # Захист від клікджекінгу
    Header always set X-Frame-Options "SAMEORIGIN"

    # Захист від підміни типів контенту
    Header always set X-Content-Type-Options "nosniff"

    # Політика передачі реферерів
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>


# ==========================================
# BROWSER CACHING (Для швидкості завантаження PageSpeed)
# ==========================================

<IfModule mod_expires.c>
    ExpiresActive On

    # Зірки швидкості для картинок та шрифтів (кеш на 1 рік)
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/avif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"

    # Стилі та скрипти
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(jpg|jpeg|png|webp|avif|svg|css|js|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
