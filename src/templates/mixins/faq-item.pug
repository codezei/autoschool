mixin faq-item(question, answer)
    .card.card-secondary.js-toggle(data-target="", data-collapse=".js-collapse")
        div
            .card__header.justify-content-between
                h4.h5.card__title.mb-0= question
                div
                    svg.icon.in-active-none(width="16" height="16")
                        use(href="#plus")
                    svg.icon.in-inactive-none(width="16" height="16")
                        use(href="#minus")
                    span.sr-only Перемкнути відповідь
            .card__body.js-collapse.lh-0
                p.card__text= answer
